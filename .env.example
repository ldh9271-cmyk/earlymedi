# ─────────────────────────────────────────────────────────
# KoreaGlowUp AI Concierge — Environment Variables
# Copy to .env.local and fill in real values
# ─────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="KoreaGlowUp AI Concierge"
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# ── Database (Drizzle direct) ────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/earlymedi
# Connection pooler (transaction mode) — for serverless runtimes
DATABASE_POOL_URL=postgresql://postgres:password@localhost:6543/earlymedi

# ── Encryption (pgcrypto) ────────────────────────────────
PII_ENCRYPTION_KEY=replace_with_32_byte_random_hex
INVITE_TOKEN_SECRET=replace_with_strong_random_secret

# ── Master / Platform Admin ──────────────────────────────
# Comma-separated emails that can impersonate ANY organization (owner
# privileges on every tenant). Used by support / founder accounts to
# debug customer issues. Every master action is still audited.
# Leave EMPTY in production unless you really need it.
MASTER_EMAILS=

# ── AI Providers ─────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./.gcp-service-account.json

# AI model defaults (fallback chain)
AI_PRIMARY_MODEL=gemini-2.5-pro
AI_FALLBACK_MODEL=claude-opus-4-7
AI_VISION_MODEL=gemini-2.5-pro
AI_STT_MODEL=whisper-1

# ── Payments ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# 토스페이먼츠 — 개발자센터 API 키 페이지의 시크릿 키(서버)와 클라이언트
# 키(결제창 SDK, 브라우저 노출용이라 NEXT_PUBLIC_). 둘 다 넣으면 예약
# 팝업이 알리페이 QR 대신 토스 결제창을 연다. 비우면 QR 흐름 유지.
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

WISE_API_TOKEN=

# ── Messaging ────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@koreaglowup.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ── Channel Integrations ─────────────────────────────────
KAKAO_REST_API_KEY=
KAKAO_CHANNEL_PUBLIC_ID=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_TOKEN=

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

WHATSAPP_BUSINESS_TOKEN=

WECHAT_OFFICIAL_TOKEN=

TELEGRAM_BOT_TOKEN=

# ── 검색엔진 소유확인 ────────────────────────────────────
# 구글: public/google….html 파일 방식이 기본. apex 가 www 로 리다이렉트
# 돼 파일 방식이 실패할 때만 'HTML 태그' 방식의 content 값을 넣는다.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저(searchadvisor.naver.com) → 사이트 소유확인
# → HTML 태그 방식의 content 값.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# Bing Webmaster Tools → Meta tag 방식의 content 값 (msvalidate.01).
# 구글 서치콘솔에서 가져오기(import)를 쓰면 이 값 없이도 인증된다.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Maps ─────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Scheduler ────────────────────────────────────────────
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Video Re-consultation ────────────────────────────────
DAILY_API_KEY=
ZOOM_API_KEY=
ZOOM_API_SECRET=

# ── FX Rates ─────────────────────────────────────────────
FX_API_KEY=
FX_PROVIDER=exchangerate-api

# ── Observability ────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# ── Feature flags ────────────────────────────────────────
FEATURE_AI_AUTOFILL=true
FEATURE_RECOVERY_PHOTO_ANALYSIS=true
FEATURE_WHITELABEL=false
